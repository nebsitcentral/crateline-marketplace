# Copy to .env for local development. On Railway, set these as service variables.
PORT=4000
NODE_ENV=development

# Postgres connection string. Railway provides DATABASE_URL when you add a Postgres plugin.
# Leave empty locally to use the in-memory store (data resets when the server restarts).
DATABASE_URL=

# Long random string. Required in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed browser origins, e.g. https://yourname.github.io
FRONTEND_ORIGIN=http://localhost:5173

# Password given to every seeded demo account (buyers, sellers, staff). Required in production.
SEED_DEMO_PASSWORD=demo-password-change-me

# Allow simulated provider results, demo time travel and data reset. Must be false once real providers exist.
SIMULATE_PROVIDERS=true
ALLOW_DEMO_CONTROLS=true

# Transactional email through Brevo (https://app.brevo.com > SMTP & API > API keys).
# EMAIL_FROM must be a sender or domain verified in Brevo. Leave BREVO_API_KEY empty locally to
# write emails to the server log instead.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Crateline
# Website address used in email links, e.g. https://yourname.github.io/crateline-marketplace
APP_URL=http://localhost:5173

# Key that encrypts two-factor secrets in the database. Any long random string; keep it stable
# (changing it makes existing two-factor set-ups unreadable). Falls back to JWT_SECRET if empty.
DATA_ENCRYPTION_KEY=

# File storage on Cloudflare R2 for deliveries, evidence and message attachments. Create a private
# bucket and an API token with "Object Read & Write" on that bucket only (R2 > Manage API tokens).
# The bucket also needs a CORS rule allowing PUT and GET from FRONTEND_ORIGIN (see README).
# Leave empty to keep attachments simulated (name and size only, nothing uploaded).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
